[{"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c74d/97b0/16_large.png?m=1727584731", "name": "share", "avatar_normal": "https://cdn.v2ex.com/navatar/c74d/97b0/16_normal.png?m=1727584731", "title": "分享发现", "url": "https://www.v2ex.com/go/share", "topics": 47566, "footer": "", "header": "分享你看到的好玩的，有信息量的，欢迎从这里获取灵感。", "title_alternative": "Share", "avatar_mini": "https://cdn.v2ex.com/navatar/c74d/97b0/16_mini.png?m=1727584731", "stars": 6380, "founder_id": 0, "aliases": [], "root": false, "id": 16, "parent_node_name": "v2ex"}, "member": {"id": 26655, "username": "xueshi", "url": "https://www.v2ex.com/u/xueshi", "website": "http://www.xueshi.me", "twitter": "XueshiQiao", "psn": "", "github": "XueshiQiao", "btc": "", "location": "北京", "tagline": "观云卷云舒，赏花开花落 (原ID：287854442)", "bio": "Nothing", "avatar_mini": "https://cdn.v2ex.com/avatar/d95b/6d57/26655_mini.png?m=1791460358", "avatar_normal": "https://cdn.v2ex.com/avatar/d95b/6d57/26655_normal.png?m=1791460358", "avatar_large": "https://cdn.v2ex.com/avatar/d95b/6d57/26655_large.png?m=1791460358", "created": 1347442180, "last_modified": 1791460358, "pro": 0}, "last_reply_by": "shortawn", "last_touched": 1792975444, "title": "有没有发现一个奇怪的现象？", "url": "https://www.v2ex.com/t/1251636", "created": 1792911452, "deleted": 0, "content": "我发现一个很奇怪，但也很有意思的现象。\r\n\r\n如果做一个 app ，开源免费发布出来，唉，不一定有多少人用。\r\n\r\n但是你说收费，然后发码，那就会有很多人要。\r\n\r\n挺奇怪的逻辑, 特别在 V2 上，我见过很多这样的。\r\n\r\n（当然，我说的这种 case 也不是绝对的\r\n\r\n有没有人愿意分析一下这是什么心理呢？ \r\n如果是开源免费的 App ，（ AI Slop 除外），应该怎么样来运营呢？", "content_rendered": "我发现一个很奇怪，但也很有意思的现象。<br /><br />如果做一个 app ，开源免费发布出来，唉，不一定有多少人用。<br /><br />但是你说收费，然后发码，那就会有很多人要。<br /><br />挺奇怪的逻辑, 特别在 V2 上，我见过很多这样的。<br /><br />（当然，我说的这种 case 也不是绝对的<br /><br />有没有人愿意分析一下这是什么心理呢？ <br />如果是开源免费的 App ，（ AI Slop 除外），应该怎么样来运营呢？", "last_modified": 1792974169, "replies": 34, "id": 1251636}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/0d0f/d7c6/408_large.png?m=1606681712", "name": "bing", "avatar_normal": "https://cdn.v2ex.com/navatar/0d0f/d7c6/408_normal.png?m=1606681712", "title": "Bing", "url": "https://www.v2ex.com/go/bing", "topics": 90, "footer": "", "header": "", "title_alternative": "Bing", "avatar_mini": "https://cdn.v2ex.com/navatar/0d0f/d7c6/408_mini.png?m=1606681712", "stars": 41, "founder_id": 0, "aliases": [], "root": false, "id": 408, "parent_node_name": "microsoft"}, "member": {"id": 440317, "username": "charley008", "url": "https://www.v2ex.com/u/charley008", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/8016/59fe/440317_mini.png?m=1792892437", "avatar_normal": "https://cdn.v2ex.com/avatar/8016/59fe/440317_normal.png?m=1792892437", "avatar_large": "https://cdn.v2ex.com/avatar/8016/59fe/440317_large.png?m=1792892437", "avatar_xlarge": "https://cdn.v2ex.com/avatar/8016/59fe/440317_xlarge.png?m=1792892437", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/8016/59fe/440317_xxlarge.png?m=1792892437", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/8016/59fe/440317_xxxlarge.png?m=1792892437", "created": 1567989487, "last_modified": 1792892437, "pro": 0}, "last_reply_by": "yws112358", "last_touched": 1792933070, "title": "Bing 中国大陆搜索是否存在对部分国外网站的刻意降权或隐藏？", "url": "https://www.v2ex.com/t/1251598", "created": 1792892916, "deleted": 0, "content": "最近发现一个非常奇怪的现象。\r\n\r\n在中国大陆使用 Bing 搜索时，输入一些知名国外网站的名称或域名，例如：\r\n\r\n- `themoviedb`\r\n- `google`\r\n- `youtube`\r\n- `telegram`\r\n- `x.com`\r\n- `openai`\r\n\r\nBing 似乎不会优先展示这些网站的官方网站，甚至在搜索结果前几页都找不到官网入口，反而推荐各种第三方网站、教程、镜像站或无关页面。\r\n\r\n以 The Movie Database （ TMDB ）为例\r\n\r\n在 Bing 搜索 `themoviedb`：\r\n\r\n- 第一条结果：`https://tmdb-pearl.vercel.app`，一个部署在 Vercel 上的第三方项目。\r\n- 第二条结果：`https://themoviesdb.org`，一个域名与官方网站非常相似的网站。\r\n- 官方网站：`https://www.themoviedb.org`，在截图所示的结果中完全没有出现。\r\n\r\n而在 Google 搜索同样的关键词，第一条就是 TMDB 官方网站。\r\n\r\n更奇怪的是，TMDB 并没有被墙\r\n\r\nGoogle 、YouTube 、Telegram 、X 、OpenAI 等网站在中国大陆存在访问限制。\r\n\r\n但 **themoviedb.org 经过我实际测试，在国内可以正常访问，并没有被墙。**\r\n\r\n也就是说，这是一个可以正常访问、知名度也不低的影视数据库网站，但 Bing 却连它的官方网站都没有优先展示。", "content_rendered": "<p>最近发现一个非常奇怪的现象。</p>\n<p>在中国大陆使用 Bing 搜索时，输入一些知名国外网站的名称或域名，例如：</p>\n<ul>\n<li><code>themoviedb</code></li>\n<li><code>google</code></li>\n<li><code>youtube</code></li>\n<li><code>telegram</code></li>\n<li><code><a href=\"http://x.com\" rel=\"nofollow\">x.com</a></code></li>\n<li><code>openai</code></li>\n</ul>\n<p>Bing 似乎不会优先展示这些网站的官方网站，甚至在搜索结果前几页都找不到官网入口，反而推荐各种第三方网站、教程、镜像站或无关页面。</p>\n<p>以 The Movie Database （ TMDB ）为例</p>\n<p>在 Bing 搜索 <code>themoviedb</code>：</p>\n<ul>\n<li>第一条结果：<code>https://tmdb-pearl.vercel.app</code>，一个部署在 Vercel 上的第三方项目。</li>\n<li>第二条结果：<code><a href=\"https://themoviesdb.org\" rel=\"nofollow\">https://themoviesdb.org</a></code>，一个域名与官方网站非常相似的网站。</li>\n<li>官方网站：<code><a href=\"https://www.themoviedb.org\" rel=\"nofollow\">https://www.themoviedb.org</a></code>，在截图所示的结果中完全没有出现。</li>\n</ul>\n<p>而在 Google 搜索同样的关键词，第一条就是 TMDB 官方网站。</p>\n<p>更奇怪的是，TMDB 并没有被墙</p>\n<p>Google 、YouTube 、Telegram 、X 、OpenAI 等网站在中国大陆存在访问限制。</p>\n<p>但 <strong><a href=\"http://themoviedb.org\" rel=\"nofollow\">themoviedb.org</a> 经过我实际测试，在国内可以正常访问，并没有被墙。</strong></p>\n<p>也就是说，这是一个可以正常访问、知名度也不低的影视数据库网站，但 Bing 却连它的官方网站都没有优先展示。</p>\n", "last_modified": 1792892916, "replies": 32, "id": 1251598}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/fd2c/5e46/1135_large.png?m=1751736785", "name": "openai", "avatar_normal": "https://cdn.v2ex.com/navatar/fd2c/5e46/1135_normal.png?m=1751736785", "title": "OpenAI", "url": "https://www.v2ex.com/go/openai", "topics": 5039, "footer": "", "header": "关于 OpenAI 旗下产品 GPT，DALL·E，和 ChatGPT 的讨论。请不要在 V2EX 的回复中粘贴复制来自 AI 生成的文本。", "title_alternative": "OpenAI", "avatar_mini": "https://cdn.v2ex.com/navatar/fd2c/5e46/1135_mini.png?m=1751736785", "stars": 3418, "founder_id": 0, "aliases": [], "root": false, "id": 1135, "parent_node_name": "geek"}, "member": {"id": 496412, "username": "privateproxies", "url": "https://www.v2ex.com/u/privatepro