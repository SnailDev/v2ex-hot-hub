[{"node": {"avatar_large": "https://cdn.v2ex.com/navatar/6e27/13a6/557_large.png?m=1747623425", "name": "life", "avatar_normal": "https://cdn.v2ex.com/navatar/6e27/13a6/557_normal.png?m=1747623425", "title": "生活", "url": "https://www.v2ex.com/go/life", "topics": 12066, "footer": "", "header": "生活中的技术讨论", "title_alternative": "Life", "avatar_mini": "https://cdn.v2ex.com/navatar/6e27/13a6/557_mini.png?m=1747623425", "stars": 2550, "founder_id": 0, "aliases": [], "root": false, "id": 557, "parent_node_name": ""}, "member": {"id": 243182, "username": "SilenceLL", "url": "https://www.v2ex.com/u/SilenceLL", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "想得太多，做的太少", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/4505/454a/243182_mini.png?m=1725416416", "avatar_normal": "https://cdn.v2ex.com/avatar/4505/454a/243182_normal.png?m=1725416416", "avatar_large": "https://cdn.v2ex.com/avatar/4505/454a/243182_large.png?m=1725416416", "avatar_xlarge": "https://cdn.v2ex.com/avatar/4505/454a/243182_xlarge.png?m=1725416416", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/4505/454a/243182_xxlarge.png?m=1725416416", "created": 1500541973, "last_modified": 1725416416, "pro": 0}, "last_reply_by": "Bapper", "last_touched": 1794313396, "title": "突然想到个一直没有想的事情，各位一般多久剪一次头发", "url": "https://www.v2ex.com/t/1255744", "created": 1794274302, "deleted": 0, "content": "之前一直是 20-30 天一次，头发乱糟糟的。今天刷到别人说 2 周一次，有点怀疑自己一直没有好好对待自己的头发了。", "content_rendered": "<p>之前一直是 20-30 天一次，头发乱糟糟的。今天刷到别人说 2 周一次，有点怀疑自己一直没有好好对待自己的头发了。</p>\n", "last_modified": 1794274944, "replies": 146, "id": 1255744}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_large.png?m=1777132346", "name": "qna", "avatar_normal": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_normal.png?m=1777132346", "title": "问与答", "url": "https://www.v2ex.com/go/qna", "topics": 242941, "footer": "", "header": "<!--\r\n一个更好的世界需要你持续地提出好问题。\r\n-->", "title_alternative": "Questions and A