[{"node": {"avatar_large": "https://cdn.v2ex.com/navatar/a4f2/3670/260_large.png?m=1778555478", "name": "security", "avatar_normal": "https://cdn.v2ex.com/navatar/a4f2/3670/260_normal.png?m=1778555478", "title": "信息安全", "url": "https://www.v2ex.com/go/security", "topics": 2090, "footer": "", "header": "我们都希望自己管理的计算机系统在运转过程中不要遇到任何安全事件。只是，这个不完美的世界的现实告诉我们：学无止境。", "title_alternative": "Security", "avatar_mini": "https://cdn.v2ex.com/navatar/a4f2/3670/260_mini.png?m=1778555478", "stars": 2201, "founder_id": 0, "aliases": [], "root": false, "id": 260, "parent_node_name": "geek"}, "member": {"id": 435539, "username": "Lightbright", "url": "https://www.v2ex.com/u/Lightbright", "website": "", "twitter": "", "psn": "", "github": "", "btc": "", "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/585d/79cd/435539_mini.png?m=1786410382", "avatar_normal": "https://cdn.v2ex.com/avatar/585d/79cd/435539_normal.png?m=1786410382", "avatar_large": "https://cdn.v2ex.com/avatar/585d/79cd/435539_large.png?m=1786410382", "created": 1565632044, "last_modified": 1786410382, "pro": 0}, "last_reply_by": "kebamt", "last_touched": 1793978709, "title": "微信输入法敏感词提取器", "url": "https://www.v2ex.com/t/1254864", "created": 1793924776, "deleted": 0, "content": "众所不周知，微信输入法存在一个内置的敏感词库\r\n\r\n具体表现为：命中该词库的输入，无法组词、联想、形成记忆、永远不会出现在候选中（例如：鸡巴）\r\n\r\n该词库并非实时联网获取，而是直接集成在输入法的安装包内\r\n\r\n出于兴趣，在 AI 的辅助下，我编写了本微信输入法敏感词提取器\r\n\r\n目前该词库的词条数量在 1 万出头，提取效果预览：\r\n\r\n~~（由于内容过于劲爆，这里不放结果了）~~\r\n\r\n本工具从微信输入法安装目录的.\\BuildIn\\cell_dict.ssrc.zh 文件提取，在 Windows 最新版测试通过\r\n\r\n具体用法：\r\n\r\n```\r\npython export_sensitive_single.py -f <cell_dict.ssrc.zh> -o <out.txt>\r\n```\r\n\r\n此外还有一些有趣的发现，微信输入法还另内置一个不那么敏感的“敏感词”库（ kind=440 ）\r\n\r\n该额外的词库虽然可以组词，但是在输入法实现中被单独归类，\r\n\r\n至于是否有特殊处理（比如记录），本人没有进一步分析\r\n\r\n工具下载地址： https://pastebin.com/emEXbrCh （提取码：x7E56zQ4uZ ）", "content_rendered": "<p>众所不周知，微信输入法存在一个内置的敏感词库</p>\n<p>具体表现为：命中该词库的输入，无法组词、联想、形成记忆、永远不会出现在候选中（例如：鸡巴）</p>\n<p>该词库并非实时联网获取，而是直接集成在输入法的安装包内</p>\n<p>出于兴趣，在 AI 的辅助下，我编写了本微信输入法敏感词提取器</p>\n<p>目前该词库的词条数量在 1 万出头，提取效果预览：</p>\n<p><del>（由于内容过于劲爆，这里不放结果了）</del></p>\n<p>本工具从微信输入法安装目录的.\\BuildIn\\cell_dict.ssrc.zh 文件提取，在 Windows 最新版测试通过</p>\n<p>具体用法：</p>\n<pre><code>python export_sensitive_single.py -f &lt;cell_dict.ssrc.zh&gt; -o &lt;out.txt&gt;\n</code></pre>\n<p>此外还有一些有趣的发现，微信输入法还另内置一个不那么敏感的“敏感词”库（ kind=440 ）</p>\n<p>该额外的词库虽然可以组词，但是在输入法实现中被单独归类，</p>\n<p>至于是否有特殊处理（比如记录），本人没有进一步分析</p>\n<p>工具下载地址： <a href=\"https://pastebin.com/emEXbrCh\" rel=\"nofollow\">https://pastebin.com/emEXbrCh</a> （提取码：x7E56zQ4uZ ）</p>\n", "last_modified": 1793925026, "replies": 159, "id": 1254864}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_large.png?m=1777132346", "name": "qna", "avatar_normal": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_normal.png?m=1777132346", "title": "问与答", "url": "https://www.v2ex.com/go/qna", "topics": 242860, "footer": "", "header": "<!--\r\n一个更好的世界需要你持续地提出好问题。\r\n-->", "title_alternative": "Questions and Answers", "avatar_mini": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_mini.png?m=1777132346", "stars": 4548, "founder_id": 0, "aliases": [], "root": false, "id": 12, "parent_node_name": "v2ex"}, "member": {"id": 712262, "username": "x2024", "url": "https://www.v2ex.com/u/x2024", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/gravatar/9d5dcf3553d3ea03ceefe4a0713969d4?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/9d5dcf3553d3ea03ceefe4a0713969d4?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/9d5dcf3553d3ea03ceefe4a0713969d4?s=73&d=retro", "created": 1727245445, "last_modified": 1727245445, "pro": 0}, "last_reply_by": "evan9527", "last_touched": 1793978139, "title": "一人一本书", "url": "https://www.v2ex.com/t/1254937", "created": 1793935306, "deleted": 0, "content": "", "content_rendered": "", "last_modified": 1793935306, "replies": 126, "id": 1254937}, {"node": {"