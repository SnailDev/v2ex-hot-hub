liases": [], "root": false, "id": 1148, "parent_node_name": "geek"}, "member": {"id": 533620, "username": "Grefer", "url": "https://www.v2ex.com/u/Grefer", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/b24170896eecf7282ebd0fdc2c7230dc?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/b24170896eecf7282ebd0fdc2c7230dc?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/b24170896eecf7282ebd0fdc2c7230dc?s=73&d=retro", "created": 1613639458, "last_modified": 1778418074, "pro": 0}, "last_reply_by": "destine", "last_touched": 1793065135, "title": "坠机日，大妈和瓦工 3 台机器都阵亡了", "url": "https://www.v2ex.com/t/1251991", "created": 1793008464, "deleted": 0, "content": "下午还在用 claude 干活儿，突然会话就显示 Server error 了，第一反应是被封号了，结果一开网页发现节点全部红了，除了一个冷门机房节点活着，其他都是端口被封了。", "content_rendered": "<p>下午还在用 claude 干活儿，突然会话就显示 Server error 了，第一反应是被封号了，结果一开网页发现节点全部红了，除了一个冷门机房节点活着，其他都是端口被封了。</p>\n", "last_modified": 1793008988, "replies": 70, "id": 1251991}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/6e27/13a6/557_large.png?m=1747623425", "name": "life", "avatar_normal": "https://cdn.v2ex.com/navatar/6e27/13a6/557_normal.png?m=1747623425", "title": "生活", "url": "https://www.v2ex.com/go/life", "topics": 11983, "footer": "", "header": "生活中的技术讨论", "title_alternative": "Life", "avatar_mini": "https://cdn.v2ex.com/navatar/6e27/13a6/557_mini.png?m=1747623425", "stars": 2532, "founder_id": 0, "aliases": [], "root": false, "id": 557, "parent_node_name": ""}, "member": {"id": 744412, "username": "NNCandy", "url": "https://www.v2ex.com/u/NNCandy", "website": "https://wth2jhl.online", "twitter": null, "psn": null, "github": null, "btc": null, "location": "深圳", "tagline": "孤独艺术家/瓜王/话痨子/侦查师", "bio": "喜欢Coding，有博客http://wth2jhl.online\r\n喜欢写作，公众号NextNow\r\n喜欢吹水，小红书xx（暂时 ----\r\n喜欢生活，抖音xx                  --- 不公开哦！）", "avatar_mini": "https://cdn.v2ex.com/avatar/8165/9b6b/744412_mini.png?m=1791969392", "avatar_normal": "https://cdn.v2ex.com/avatar/8165/9b6b/744412_normal.png?m=1791969392", "avatar_large": "https://cdn.v2ex.com/avatar/8165/9b6b/744412_large.png?m=1791969392", "avatar_xlarge": "https://cdn.v2ex.com/avatar/8165/9b6b/744412_xlarge.png?m=1791969392", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/8165/9b6b/744412_xxlarge.png?m=1791969392", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/8165/9b6b/744412_xxxlarge.png?m=1791969392", "created": 1744790025, "last_modified": 1791969392, "pro": 0}, "last_reply_by": "PbCopy111", "last_touched": 1793065013, "title": "你们是如何和岳父岳母相处的", "url": "https://www.v2ex.com/t/1251970", "created": 1793005185, "deleted": 0, "content": "一些纲常问题\r\n\r\n现在岳父母给我老婆大哥带小孩，住的离我们买的房子比较近，但是也有个 20 分钟左右的路程，每周都可以选择回去蹭顿饭，然后回来，而家里目前就我和我老婆两个住。\r\n\r\n\r\n我怕总是蹭吃蹭喝不方便，所以每次上门都买点东西，水果、酒啥的，但是感觉好像为了吃顿饭也没啥必要？而我老婆很喜欢回去吃，我只能和她一起回去了。\r\n\r\n回去多了，我又不干活，感觉是现眼包，坐着刷手机等吃，非常不好。。而我本身也会厨艺，但是偏很耐心做的那种，花的时间比较长，而岳母也不想我展示算是。。。\r\n\r\n然后，我又不喝酒，，我岳父喜欢喝酒，我又陪不了他，他们还飙家乡话。。我只能微笑点头，装傻吃饭，倒是挺不自在的。。。", "content_rendered": "<p>一些纲常问题</p>\n<p>现在岳父母给我老婆大哥带小孩，住的离我们买的房子比较近，但是也有个 20 分钟左右的路程，每周都可以选择回去蹭顿饭，然后回来，而家里目前就我和我老婆两个住。</p>\n<p>我怕总是蹭吃蹭喝不方便，所以每次上门都买点东西，水果、酒啥的，但是感觉好像为了吃顿饭也没啥必要？而我老婆很喜欢回去吃，我只能和她一起回去了。</p>\n<p>回去多了，我又不干活，感觉是现眼包，坐着刷手机等吃，非常不好。。而我本身也会厨艺，但是偏很耐心做的那种，花的时间比较长，而岳母也不想我展示算是。。。</p>\n<p>然后，我又不喝酒，，我岳父喜欢喝酒，我又陪不了他，他们还飙家乡话。。我只能微笑点头，装傻吃饭，倒是挺不自在的。。。</p>\n", "last_modified": 1793005185, "replies": 67, "id": 1251970}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_large.png?m=1768280127", "name": "career", "avatar_normal": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_normal.png?m=1768280127", "title": "职场话题", "url": "https://www.v2ex.com/go/career", "topics": 24670, "footer": "", "header": "这里，我们聊聊那些工作中遇到的开心和不开心的事。", "title_alternative": "Career", "avatar_mini": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_mini.png?m=1768280127", "stars": 3755, "founder_id": 0, "aliases": [], "root": false, "id": 770, "parent_node_name": ""}, "member": {"id": 598700, "username": "lidedongsn", "url": "https://www.v2ex.com/u/lidedongsn", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/9fc3/67ed/598700_mini.png?m=1791875065", "avatar_normal": "https://cdn.v2ex.com/avatar/9fc3/67ed/598700_normal.png?m=1791875065", "avatar_large": "https://cdn.v2ex.com/avatar/9fc3/67ed/598700_large.png?m=1791875065", "avatar_xlarge": "https://cdn.v2ex.com/avatar/9fc3/67ed/598700_xlarge.png?m=1791875065", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/9fc3/67ed/598700_xxlarge.png?m=1791875065", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/9fc3/67ed/598700_xxxlarge.png?m=1791875065", "created": 1666594594, "last_modified": 1791875065, "pro": 0}, "last_reply_by": "Autonomous", "last_touched": 1793035222, "title": "周一刚开工，就面谈通知被裁，心情复杂", "url": "https://www.v2ex.com/t/1251815", "created": 1792983494, "deleted": 0, "content": "年过 36 啊，这不知道还能不能干这个行业了，太难了", "content_rendered": "<p>年过 36 啊，这不知道还能不能干这个行业了，太难了</p>\n", "last_modified": 1792983494, "replies": 59, "id": 1251815}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_large.png?m=1768280127", "name": "career", "avatar_normal": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_normal.png?m=1768280127", "title": "职场话题", "url": "https://www.v2ex.com/go/career", "topics": 24670, "footer": "", "header": "这里，我们聊聊那些工作中遇到的开心和不开心的事。", "title_alternative": "Career", "avatar_mini": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_mini.png?m=1768280127", "stars": 3755, "founder_id": 0, "aliases": [], "root": false, "id": 770, "parent_node_name": ""}, "member": {"id": 825866, "username": "wises", "url": "https://www.v2ex.com/u/wises", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/gravatar/f3cd7b451651e027df6fae684d587b78?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/f3cd7b451651e027df6fae684d587b78?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/f3cd7b451651e027df6fae684d587b78?s=73&d=retro", "created": 1782830370, "last_modified": 1787923151, "pro": 0}, "last_reply_by": "lyb11232345688", "last_touched": 1793064971, "title": "AI vibe coding 的进展，不知道程序员还能存活多久？", "url": "https://www.v2ex.com/t/1251976", "created": 1793005709, "deleted": 0, "content": "我那开劳斯莱斯的朋友，7 月份时候还是 coding 白痴， 但经过几个月的 vibe coding, 现在已经成功上线了工厂的 erp ，并且是那种可以当生产力工具用的，且按照他的说法，简直完美的和他工厂所有流程吻合。他正在慢慢的把周边模块一点一点的加上，不断的接入周边硬件，基本上都是许愿式的提交需求，大部分一次可以搞定。\r\n\r\n而最关键的是，他已经知道利用 github actions 通过 Claude 做自动化部署实施，前 2 个月他还孤军奋战，现在他在 erp 中做了 issue/function request 提交界面，员工可以在该页面上直接提交到 github issue 中，他只是在 erp （可以直接看到 issues 所有状态）中看下员工提交的 issues, 判断后批准 Claude 直接接手进行修改代码经 github actions 自动部署的全自动化流程，拒绝则直接打回不执行，但有了 issue 记录，未来也可以进行回顾和评估。 \r\n\r\n本来 Claude 搞完后还有个测试和预览过程，但这几个月他发现 Claude 做这种应用类软件，杀鸡用牛刀，所以取消了这个环节，反正现在整个框架和流程已经基本确定，所做的也只是一些小的修改和完善，无非是配色，布局，拼写错误之类的修改。\r\n\r\n目前他已经进入到下一阶段，本地部署大模型（已经组装了算力服务器，虽然配置不太高，但基本工厂企业使用也最多是简单的 coding/视频图像处理）， 看是否可以替代 Claude code ，正在进行测试。也同时在评估工厂内部部署 gitlab 之类支持 github actions/runner 之类软件，达到未来实现全流程内部封闭运行，不依靠任何外部服务。\r\n\r\n我会有空过来说下进度，各位有问题也可以提，因为他这个项目基本是我引导进行，相信会给你一些少走弯路的建议。", "content_rendered": "我那开劳斯莱斯的朋友，7 月份时候还是 coding 白痴， 但经过几个月的 vibe coding, 现在已经成功上线了工厂的 erp ，并且是那种可以当生产力工具用的，且按照他的说法，简直完美的和他工厂所有流程吻合。他正在慢慢的把周边模块一点一点的加上，不断的接入周边硬件，基本上都是许愿式的提交需求，大部分一次可以搞定。<br /><br />而最关键的是，他已经知道利用 github actions 通过 Claude 做自动化部署实施，前 2 个月他还孤军奋战，现在他在 erp 中做了 issue/function request 提交界面，员工可以在该页面上直接提交到 github issue 中，他只是在 erp （可以直接看到 issues 所有状态）中看下员工提交的 issues, 判断后批准 Claude 直接接手进行修改代码经 github actions 自动部署的全自动化流程，拒绝则直接打回不执行，但有了 issue 记录，未来也可以进行回顾和评估。 <br /><br />本来 Claude 搞完后还有个测试和预览过程，但这几个月他发现 Claude 做这种应用类软件，杀鸡用牛刀，所以取消了这个环节，反正现在整个框架和流程已经基本确定，所做的也只是一些小的修改和完善，无非是配色，布局，拼写错误之类的修改。<br /><br />目前他已经进入到下一阶段，本地部署大模型（已经组装了算力服务器，虽然配置不太高，但基本工厂企业使用也最多是简单的 coding/视频图像处理）， 看是否可以替代 Claude code ，正在进行测试。也同时在评估工厂内部部署 gitlab 之类支持 github actions/runner 之类软件，达到未来实现全流程内部封闭运行，不依靠任何外部服务。<br /><br />我会有空过来说下进度，各位有问题也可以提，因为他这个项目基本是我引导进行，相信会给你一些少走弯路的建议。", "last_modified": 1793059797, "replies": 58, "id": 1251976}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/6e27/13a6/557_large.png?m=1747623425", "name": "life", "avatar_normal": "https://cdn.v2ex.com/navatar/6e27/13a6/557_normal.png?m=1747623425", "title": "生活", "url": "https://www.v2ex.com/go/life", "topics": 11983, "footer": "", "header": "生活中的技术讨论", "title_alternative": "Life", "avatar_mini": "https://cdn.v2ex.com/navatar/6e27/13a6/557_mini.png?m=1747623425", "stars": 2532, "founder_id": 0, "aliases": [], "root": false, "id": 557, "parent_node_name": ""}, "member": {"id": 731715, "username": "LongjingTea", "url": "https://www.v2ex.com/u/LongjingTea", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/f7233a10c30edac3f9339e7e03aa74cc?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/f7233a10c30edac3f9339e7e03aa74cc?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/f7233a10c30edac3f9339e7e03aa74cc?s=73&d=retro", "created": 1737355031, "last_modified": 1770168591, "pro": 0}, "last_reply_by": "isnullstring", "last_touched": 1793008114, "title": "大家一个月可以存下多少钱", "url": "https://www.v2ex.com/t/1251794", "created": 1792980948, "deleted": 0, "content": "想问下大家一个月平均可以存下多少钱，只考虑工资部分的话", "content_rendered": "想问下大家一个月平均可以存下多少钱，只考虑工资部分的话", "last_modified": 1792980948, "replies": 53, "id": 1251794}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_large.png?m=1733731195", "name": "programmer", "avatar_normal": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_normal.png?m=1733731195", "title": "程序员", "url": "https://www.v2ex.com/go/programmer", "topics": 74133, "footer": "", "header": "While code monkeys are not eating bananas, they're coding.", "title_alternative": "Programmer", "avatar_mini": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_mini.png?m=1733731195", "stars": 9812, "founder_id": 0, "aliases": [], "root": false, "id": 300, "parent_node_name": "computer"}, "member": {"id": 656997, "username": "phoenix380", "url": "https://www.v2ex.com/u/phoenix380", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/857de230e6ae086bd1a8e969724c4caa?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/857de230e6ae086bd1a8e969724c4caa?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/857de230e6ae086bd1a8e969724c4caa?s=73&d=retro", "created": 1698658122, "last_modified": 1698658122, "pro": 0}, "last_reply_by": "luting", "last_touched": 1793035131, "title": "self-host 代码仓库，各位老哥公司里都是什么方案？", "url": "https://www.v2ex.com/t/1251810", "created": 1792982366, "deleted": 0, "content": "最近要评估迁移 gh 的代码到本地了，想咨询下 v2 老哥们的公司规模和使用的哪家自建方案？\r\n涵 CI/CD 吗？", "content_rendered": "<p>最近要评估迁移 gh 的代码到本地了，想咨询下 v2 老哥们的公司规模和使用的哪家自建方案？\n涵 CI/CD 吗？</p>\n", "last_modified": 1792982366, "replies": 53, "id": 1251810}]