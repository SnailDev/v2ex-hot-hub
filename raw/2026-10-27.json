[{"node": {"avatar_large": "https://cdn.v2ex.com/navatar/642e/92ef/48_large.png?m=1559027807", "name": "tv", "avatar_normal": "https://cdn.v2ex.com/navatar/642e/92ef/48_normal.png?m=1559027807", "title": "剧集", "url": "https://www.v2ex.com/go/tv", "topics": 981, "footer": "", "header": "", "title_alternative": "TV", "avatar_mini": "https://cdn.v2ex.com/navatar/642e/92ef/48_mini.png?m=1559027807", "stars": 946, "founder_id": 0, "aliases": [], "root": false, "id": 48, "parent_node_name": "life"}, "member": {"id": 512839, "username": "space2020", "url": "https://www.v2ex.com/u/space2020", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/avatar/d9d6/8807/512839_mini.png?m=1787107512", "avatar_normal": "https://cdn.v2ex.com/avatar/d9d6/8807/512839_normal.png?m=1787107512", "avatar_large": "https://cdn.v2ex.com/avatar/d9d6/8807/512839_large.png?m=1787107512", "avatar_xlarge": "https://cdn.v2ex.com/avatar/d9d6/8807/512839_xlarge.png?m=1787107512", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/d9d6/8807/512839_xxlarge.png?m=1787107512", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/d9d6/8807/512839_xxxlarge.png?m=1787107512", "created": 1602686375, "last_modified": 1787107512, "pro": 0}, "last_reply_by": "ElmerZhang", "last_touched": 1793065143, "title": "大家有没有好看的电视剧推荐，最近出的，经典的都行", "url": "https://www.v2ex.com/t/1251787", "created": 1792979970, "deleted": 0, "content": "我先来几个抛砖引玉，《毛骗》《端脑 真人版》《大秦帝国 裂变 纵横 崛起》", "content_rendered": "我先来几个抛砖引玉，《毛骗》《端脑 真人版》《大秦帝国 裂变 纵横 崛起》", "last_modified": 1793060571, "replies": 144, "id": 1251787}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_large.png?m=1768280127", "name": "career", "avatar_normal": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_normal.png?m=1768280127", "title": "职场话题", "url": "https://www.v2ex.com/go/career", "topics": 24670, "footer": "", "header": "这里，我们聊聊那些工作中遇到的开心和不开心的事。", "title_alternative": "Career", "avatar_mini": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_mini.png?m=1768280127", "stars": 3755, "founder_id": 0, "aliases": [], "root": false, "id": 770, "parent_node_name": ""}, "member": {"id": 495902, "username": "vergilgao", "url": "https://www.v2ex.com/u/vergilgao", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/avatar/5340/d08e/495902_mini.png?m=1792989171", "avatar_normal": "https://cdn.v2ex.com/avatar/5340/d08e/495902_normal.png?m=1792989171", "avatar_large": "https://cdn.v2ex.com/avatar/5340/d08e/495902_large.png?m=1792989171", "created": 1592825737, "last_modified": 1792989171, "pro": 0}, "last_reply_by": "vergilgao", "last_touched": 1793041008, "title": "媳妇上个月辞职出来创业了", "url": "https://www.v2ex.com/t/1251868", "created": 1792991152, "deleted": 0, "content": "行业是青少年脊柱侧弯康复矫正，她是做施罗斯体操私教课的的康复师。\r\n\r\n去年她原来的公司黄了，她自己又找个一个机构打工，一年以后因为各种因素辞职了，准备自己单干。我就老老实实上班，没事的时候给她出谋划策，解决 IT 问题，顺便她上课和看诊的时候给她做摄影师。\r\n\r\n上个月我们找了一个商业公寓楼租了一个跃层，一楼办公，二楼改造成了训练区。简单收拾了一下就开干了。因为她辞职之前就积累了很多患者，有大概 5 个左右的家长在原来的机构退费了，到她这里重新交了钱继续训练，也就成了我们现在的启动资金。\r\n\r\n这一个月跑手续，申请营业执照，注册地图，抖音上团购。前几天又买了个新手机用来运营和录视频，启动资金花的还挺快。\r\n\r\n我俩都属于那种貔貅的性格，存起来的钱就不想花，所以这一个月手里可动用的资金全来自于家长的缴费和我 9 月底发的工资（我还先存了一部分）。现在老家长都缴费过了，销课得俩月，然后才能再交钱，而且孩子康复了就不会再练了。现在我俩就有点焦虑拉新的问题了。\r\n\r\n其实我们还是按节奏走，印了传单，这周工作日她在工作室写脚本录视频，争取这周就剪一条发出来。就是在获取到第一个非以前的老家长的新客之前，心里这块石头总是放不下。", "content_rendered": "<p>行业是青少年脊柱侧弯康复矫正，她是做施罗斯体操私教课的的康复师。</p>\n<p>去年她原来的公司黄了，她自己又找个一个机构打工，一年以后因为各种因素辞职了，准备自己单干。我就老老实实上班，没事的时候给她出谋划策，解决 IT 问题，顺便她上课和看诊的时候给她做摄影师。</p>\n<p>上个月我们找了一个商业公寓楼租了一个跃层，一楼办公，二楼改造成了训练区。简单收拾了一下就开干了。因为她辞职之前就积累了很多患者，有大概 5 个左右的家长在原来的机构退费了，到她这里重新交了钱继续训练，也就成了我们现在的启动资金。</p>\n<p>这一个月跑手续，申请营业执照，注册地图，抖音上团购。前几天又买了个新手机用来运营和录视频，启动资金花的还挺快。</p>\n<p>我俩都属于那种貔貅的性格，存起来的钱就不想花，所以这一个月手里可动用的资金全来自于家长的缴费和我 9 月底发的工资（我还先存了一部分）。现在老家长都缴费过了，销课得俩月，然后才能再交钱，而且孩子康复了就不会再练了。现在我俩就有点焦虑拉新的问题了。</p>\n<p>其实我们还是按节奏走，印了传单，这周工作日她在工作室写脚本录视频，争取这周就剪一条发出来。就是在获取到第一个非以前的老家长的新客之前，心里这块石头总是放不下。</p>\n", "last_modified": 1792991152, "replies": 83, "id": 1251868}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/83ad/c922/1358_large.png?m=1783590142", "name": "proxyrovider", "avatar_normal": "https://cdn.v2ex.com/navatar/83ad/c922/1358_normal.png?m=1783590142", "title": "机场", "url": "https://www.v2ex.com/go/proxyrovider", "topics": 4, "footer": "", "header": "", "title_alternative": "机场", "avatar_mini": "https://cdn.v2ex.com/navatar/83ad/c922/1358_mini.png?m=1783590142", "stars": 6, "founder_id": 771892, "aliases": [], "root": false, "id": 1358, "parent_node_name": null}, "member": {"id": 615649, "username": "enzocc", "url": "https://www.v2ex.com/u/enzocc", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/9b19/1a30/615649_mini.png?m=1776148407", "avatar_normal": "https://cdn.v2ex.com/avatar/9b19/1a30/615649_normal.png?m=1776148407", "avatar_large": "https://cdn.v2ex.com/avatar/9b19/1a30/615649_large.png?m=1776148407", "avatar_xlarge": "https://cdn.v2ex.com/avatar/9b19/1a30/615649_xlarge.png?m=1776148407", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/9b19/1a30/615649_xxlarge.png?m=1776148407", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/9b19/1a30/615649_xxxlarge.png?m=1776148407", "created": 1677121807, "last_modified": 1776148407, "pro": 0}, "last_reply_by": "iv2ex", "last_touched": 1793064907, "title": "佬们推荐个机场，花云太差了", "url": "https://www.v2ex.com/t/1251841", "created": 1792986271, "deleted": 0, "content": "https://imgur.com/qcRsMiX\r\n\r\n花云刚开始用挺好的，后面越来越差经常所有节点飙红\r\n\r\n下个月到期准备换了", "content_rendered": "<p><a href=\"https://imgur.com/qcRsMiX\" rel=\"nofollow\">https://imgur.com/qcRsMiX</a></p>\n<p>花云刚开始用挺好的，后面越来越差经常所有节点飙红</p>\n<p>下个月到期准备换了</p>\n", "last_modified": 1792986304, "replies": 78, "id": 1251841}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/6e27/13a6/557_large.png?m=1747623425", "name": "life", "a